# ==============================================================================
# SMF SHOP - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# - Copy this file to .env: cp .env.example .env
# - Fill in your credentials.
# - In production, never use default or placeholder values for security keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED IN PRODUCTION
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCDEFghijklmnopqrstuvwxyz_1234567

# Numeric Telegram ID of the admin allowed to run /admin & /adminstats
ADMIN_ID=123456789
# Optional alias (used only if ADMIN_ID is empty):
# ADMIN_TG_ID=123456789

# Web Admin Panel Credentials
ADMIN_USERNAME=admin
# Set ADMIN_PASSWORD_HASH (Argon2id or bcrypt hash) or a strong ADMIN_PASSWORD
# To generate a hash: python -c "from utils.security import hash_password; print(hash_password('your_strong_password'))"
ADMIN_PASSWORD=generate_a_strong_admin_password_here
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...

# Application Security (Must be random strings of 32+ characters in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_32_character_string_here
SESSION_SECRET=generate_a_different_random_32_character_string_here

# Database URL
# For Railway PostgreSQL: postgresql+psycopg://username:password@host:port/database
# For SQLite on persistent volume: sqlite:////app/data/smm_reseller.db
DATABASE_URL=sqlite:///./smm_reseller.db

# Deployment environment (set to 'production' on Railway, 'development' locally)
DEPLOYMENT_ENV=development
LOG_LEVEL=INFO

# Public URL for webhooks and admin links (e.g. https://your-service.up.railway.app)
WEBHOOK_URL=https://your-service.up.railway.app
ADMIN_PANEL_URL=https://your-service.up.railway.app/admin/login

# ------------------------------------------------------------------------------
# 2. OPTIONAL REDIS & RATE LIMITING
# ------------------------------------------------------------------------------
# Set to enable Redis-backed distributed sliding-window rate limiting.
# If empty, an in-memory thread-safe rate limiter is used automatically.
# REDIS_URL=redis://default:password@host:port

# ------------------------------------------------------------------------------
# 3. WALLET & PAYMENT GATEWAYS
# ------------------------------------------------------------------------------
# USDT Deposit addresses
USDT_NETWORK=BEP20
USDT_ADDRESS=0x0000000000000000000000000000000000000000
BEP20_USDT_ADDRESS=0x0000000000000000000000000000000000000000
TRC20_USDT_ADDRESS=T000000000000000000000000000000000
BINANCE_PAY_ID=your_binance_pay_id_or_uid
BYBIT_PAY_ID=your_bybit_pay_id_or_uid

# Payment auto-verification (optional)
AUTO_VERIFY_ENABLED=true
BSCSCAN_API_KEY=your_bscscan_api_key_here
TRONSCAN_API_KEY=your_tronscan_api_key_here
BINANCE_API_KEY=your_binance_read_only_api_key
BINANCE_API_SECRET=your_binance_read_only_api_secret
BYBIT_API_KEY=your_bybit_read_only_api_key
BYBIT_API_SECRET=your_bybit_read_only_api_secret
VERIFICATION_TIMEOUT=300
REQUIRED_CONFIRMATIONS=2

# Residential proxy URL if Binance/Bybit or upstream panels geo-block datacenter IPs:
# BINANCE_HTTP_PROXY=http://username:password@proxy-host:port
# PROVIDER_HTTP_PROXY=http://username:password@proxy-host:port

# PayFast Gateway (Pakistan IPG)
# PAYFAST_MERCHANT_ID=your_merchant_id
# PAYFAST_SECURED_KEY=your_secured_key
# PAYFAST_STORE_ID=your_store_id
# PAYFAST_BASE_URL=https://ipg2.apps.net.pk

# ------------------------------------------------------------------------------
# 4. STORE & INVENTORY SETTINGS
# ------------------------------------------------------------------------------
AUTO_DEDUCT_ON_ORDER=true
LOW_STOCK_THRESHOLD=10
UNPAID_CHECKOUT_EXPIRE_MINUTES=10
REFERRAL_COMMISSION_DEFAULT=15
SUPPORT_EMAIL=admin@yourpanel.com

# ------------------------------------------------------------------------------
# 5. WEB MINI APP / STOREFRONT
# ------------------------------------------------------------------------------
# MINI_APP_URL=https://your-service.up.railway.app/mini
# CORS_ORIGINS=https://your-service.up.railway.app
