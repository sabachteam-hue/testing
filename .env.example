# BOT
BOT_TOKEN=your_telegram_bot_token
# Telegram numeric ID of the only user allowed to use /admin (SMF-style name).
ADMIN_ID=7518213315
# Optional alias — used only if ADMIN_ID is empty:
# ADMIN_TG_ID=7518213315
# Panel login username is always "admin". Password:
ADMIN_PASSWORD=admin123
# Full admin login URL sent by /admin (preferred):
ADMIN_PANEL_URL=https://smf-production-68d3.up.railway.app/admin/login
# Or set a public base URL and /admin/login will be appended:
# WEBHOOK_BASE_URL=https://smf-production-68d3.up.railway.app

# DATABASE
# Use Postgres URL from Railway Postgres, or SQLite on a Railway volume.
# Do not put your Railway website URL here.
DATABASE_URL=sqlite:///./smm_reseller.db

# SECURITY
SECRET_KEY=change_this_to_random_string_32chars
SESSION_SECRET=random_session_secret

# WALLET
USDT_ADDRESS=0x1234567890abcdef
USDT_NETWORK=BEP20
BEP20_USDT_ADDRESS=0x1234567890abcdef
TRC20_USDT_ADDRESS=Txxxxxxxxxxxxxxxxxxxxxxxxxxxx
BINANCE_PAY_ID=your_binance_pay_id_or_uid
BYBIT_PAY_ID=your_bybit_pay_id_or_uid

# PAYMENT VERIFICATION
AUTO_VERIFY_ENABLED=true
BSCSCAN_API_KEY=your_bscscan_api_key
TRONSCAN_API_KEY=your_tronscan_api_key
BINANCE_API_KEY=your_binance_read_only_api_key
BINANCE_API_SECRET=your_binance_read_only_api_secret
# Bybit: enables Bybit Pay auto-verify (internal UID transfers) + on-chain deposit fallback
BYBIT_API_KEY=your_bybit_read_only_api_key
BYBIT_API_SECRET=your_bybit_read_only_api_secret
VERIFICATION_TIMEOUT=300
REQUIRED_CONFIRMATIONS=2

# ADMIN PANEL
PANEL_HOST=0.0.0.0
PANEL_PORT=8000

# API SETTINGS
API_RATE_LIMIT_DEFAULT=100
API_TIMEOUT=30

# STOCK
AUTO_DEDUCT_ON_ORDER=true
LOW_STOCK_THRESHOLD=10
# Unpaid PayFast checkout auto-expire (minutes). Order + payment link become
# "expired", reserved stock is released, and rows leave the Pending filters.
UNPAID_CHECKOUT_EXPIRE_MINUTES=10

# REFERRAL
REFERRAL_COMMISSION_DEFAULT=15

# SUPPORT
SUPPORT_EMAIL=admin@yourpanel.com

# DEPLOYMENT
DEPLOYMENT_ENV=production
LOG_LEVEL=INFO
WEBHOOK_BASE_URL=https://your-app.up.railway.app

# WEB MINI APP
# Live catalog UI is served at /mini on this server. Telegram Open Shop uses
# that path automatically if Settings / MINI_APP_URL is empty or a Vercel sample.
# MINI_APP_URL=https://your-app.up.railway.app/mini
# CORS_ORIGINS=https://your-app.up.railway.app


# CANVA EDUCATION AUTO INVITES
# Select "Canva Education (auto email invite)" on the product in Admin.
CANVA_AUTOMATION_ENABLED=false
# Exact Canva Education team People/settings URL that shows the Invite button.
CANVA_TEAM_URL=https://www.canva.com/settings/people
CANVA_SESSION_PATH=/data/canva/session.json
CANVA_WORKER_SECONDS=30
# Generate once with: python canva_login_setup.py (KEEP SECRET)
CANVA_STORAGE_STATE_B64=

# Canva automation mode
# railway = headless Playwright runs on Railway (legacy/default)
# local   = paid Canva orders are claimed by canva_local_worker.py on Windows
CANVA_AUTOMATION_MODE=railway
# Required only for local mode. Use a long random value and keep it private.
CANVA_REMOTE_WORKER_TOKEN=
# Local Windows worker only:
CANVA_WORKER_SERVER_URL=
CANVA_LOCAL_PROFILE_DIR=%USERPROFILE%\CanvaAutomationProfile
CANVA_LOCAL_POLL_SECONDS=10
